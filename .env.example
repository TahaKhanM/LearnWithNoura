# Required. The only key Seneca needs: it powers the realtime voice tutor,
# the text fallback, and session summaries. Never committed.
OPENAI_API_KEY=your_openai_api_key_here

# The live speech-to-speech tutor model.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Text model used for the captions-only fallback and parent summaries.
OPENAI_MODEL=gpt-5.6-terra

# Backend port. The Vite dev server proxies /api and /ws here.
PORT=8787
