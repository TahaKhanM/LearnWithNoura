# OpenAI provider key. Keep this server-side and never commit a real value.
OPENAI_API_KEY=your_openai_api_key_here

# Verified runtime baseline. GPT-5.6 Sol was the implementation agent only;
# it is not an application runtime dependency.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_MODEL=gpt-5.6-terra

# Session-creation lesson compiler (Chat Completions). Defaults shown.
# NOURA_COMPILER_MODEL=gpt-5.6-terra
# NOURA_COMPILER_REASONING_EFFORT=medium
# Dev/Preview defaults to streaming at low effort after corrected M1 acceptance.
# Set `classic` for rollback; classic defaults to medium effort.
# NOURA_DIRECTOR_PIPELINE=streaming
# NOURA_DIRECTOR_MODEL=gpt-5.6-terra
# NOURA_DIRECTOR_REASONING_EFFORT=low
# Independent adaptive audit role; corrected M0 evidence selected Luna-low.
# NOURA_VISION_AUDIT_MODEL=gpt-5.6-luna
# NOURA_VISION_AUDIT_REASONING_EFFORT=low
# Illustration lane (M4). Default gpt-image-2; at most two paid generations per lesson.
# NOURA_ILLUSTRATION_MODEL=gpt-image-2
# NOURA_ILLUSTRATIONS=off
# Board harness page for headless scene validation; defaults to the local
# dev server's /dev/board outside production.
# NOURA_BOARD_HARNESS_URL=http://127.0.0.1:5173/dev/board
# Deterministic fixture compiler for offline dev and hermetic tests ONLY.
# Production startup refuses this flag.
# NOURA_LESSON_COMPILER=fixture

# Local/private synthetic development.
NOURA_DEPLOYMENT_MODE=local-synthetic
NOURA_SYNTHETIC_ONLY=true
NOURA_CANONICAL_ORIGIN=https://learnwithnoura.com
NOURA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787
NOURA_DATA_DIR=./data
NOURA_CAMERA_RESPONSIVE=false

# Local backend port. Vite proxies /api and /ws here.
PORT=8787

# Public product v0: real tutor runtime with managed Postgres and a signed,
# pseudonymous guest-parent cookie. Keep synthetic-only true and do not use
# real child details while the legal/privacy gates below remain open.
# NOURA_DEPLOYMENT_MODE=production-v0
# DATABASE_URL=
# NOURA_STORAGE_ADAPTER=postgres
# NOURA_LESSON_CAPABILITY_SECRET=
# Public v0 may temporarily set this false for the Supavisor shared-pooler
# chain. Full Production must pin the Supabase CA and leave verification true.
# NOURA_DATABASE_SSL_REJECT_UNAUTHORIZED=true
# NOURA_POSTGRES_AUTO_MIGRATE=false

# Full Production gates (real parent/child use). Full Production still fails
# closed while any required control is unavailable.
# NOURA_AUTH_PROVIDER=
# NOURA_AUTH_SECRET=
# NOURA_PRIVACY_POLICY_VERSION=
# NOURA_SAFETY_MODE=
# NOURA_UNDER_13_MODE=disabled
# NOURA_ZDR_EVIDENCE_REFERENCE=
# NOURA_BUILD_SHA=

# Deprecated for one migration window only. Prefer NOURA_DATA_DIR.
# SENECA_DATA_DIR=./data
