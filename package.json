{
  "name": "noura",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client": "vite",
    "server": "tsx watch server/index.ts",
    "dev": "concurrently -k -n client,server -c blue,green \"npm:client\" \"npm:server\"",
    "build": "tsc -b && vite build",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:brand": "node scripts/brand-scan.mjs",
    "test:integration": "vitest run server src/lesson src/board shared",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual",
    "test:a11y": "playwright test tests/accessibility",
    "test:security": "vitest run server/security.test.ts server/api.auth.test.ts server/store/repo.test.ts",
    "test:storage": "vitest run server/store/portable.test.ts server/store/postgresRepo.test.ts server/store/db.test.ts",
    "test:runtime-models": "node scripts/runtime-model-diff.mjs",
    "test:av": "tsx scripts/evaluate-av-character.ts",
    "test:lesson-eval": "tsx scripts/evaluate-lesson.ts",
    "test:director-eval": "tsx scripts/evaluate-director.ts",
    "test:director-m1-eval": "tsx scripts/evaluate-director-m1.ts",
    "test:director-recovery": "tsx scripts/evaluate-director-recovery.ts",
    "test:first-paint": "tsx scripts/evaluate-first-paint.ts",
    "test:m1-acceptance": "tsx scripts/evaluate-m1-acceptance.ts",
    "test:role-adoption": "tsx scripts/evaluate-role-adoption.ts",
    "test:m2-live-smoke": "tsx scripts/verify-m2-live-smoke.ts",
    "test:smoke-report": "node --test scripts/e2e-live.node-test.mjs",
    "e2e:live": "node scripts/e2e-live.mjs"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@types/ws": "^8.18.1",
    "@vercel/functions": "^3.9.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "katex": "^0.18.3",
    "openai": "^7.4.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^10.0.4",
    "fast-check": "^4.9.0",
    "jsdom": "^28.1.0",
    "oxlint": "^1.75.0",
    "pg-mem": "^3.0.14",
    "playwright": "^1.62.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
